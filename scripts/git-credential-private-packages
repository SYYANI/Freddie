#!/bin/sh

# Git calls this helper for the private Swift packages in project.yml.
[ "${1:-}" = get ] || exit 0

protocol=
host=
path=
while IFS='=' read -r key value; do
    case "$key" in
        protocol) protocol="$value" ;;
        host) host="$value" ;;
        path) path="$value" ;;
    esac
done

[ "$protocol" = https ] && [ "$host" = github.com ] || exit 0
case "$path" in
    SYYANI/swift-readability|SYYANI/swift-readability.git|\
    SYYANI/BabelDOC|SYYANI/BabelDOC.git|\
    SYYANI/arxivLatex|SYYANI/arxivLatex.git|\
    SYYANI/SwiftStreamingMarkdown|SYYANI/SwiftStreamingMarkdown.git) ;;
    *) exit 0 ;;
esac

[ -n "${READPAPER_PACKAGES_TOKEN:-}" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$READPAPER_PACKAGES_TOKEN"
